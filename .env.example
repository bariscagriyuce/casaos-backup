# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env

# Saat dilimi (zamanlama bu saate göre çalışır)
TZ=Europe/Istanbul

# --- Restic deposu ---
# "gdrive" = rclone config'te verdiğiniz remote adı, "casaos-backup" = Drive'daki klasör
RESTIC_REPOSITORY=rclone:gdrive:casaos-backup
# Yedekler bu parolayla şifrelenir. KAYBEDERSENİZ YEDEKLERİ AÇAMAZSINIZ. Güvenli bir yere not edin.
RESTIC_PASSWORD=buraya-uzun-ve-rastgele-bir-parola-yazin

# --- Zamanlama (cron formatı) ---
BACKUP_CRON=0 3 * * *
# Haftalık depo bütünlük kontrolü (verinin %5'ini okuyup doğrular)
CHECK_CRON=0 5 * * 0
# Konteyner açılır açılmaz bir yedek al
RUN_ON_START=false

# --- Saklama politikası ---
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# --- Tutarlılık için konteyner durdurma ---
# all     : yedek sırasında tüm çalışan konteynerleri durdur (etiketi casaos-backup.stop=false olanlar hariç)
# labeled : sadece casaos-backup.stop=true etiketli konteynerleri durdur
# none    : hiçbirini durdurma (veritabanları tutarsız yedeklenebilir)
STOP_MODE=all
STOP_TIMEOUT=60

# --- Bildirimler (opsiyonel) ---
# failure | always | never
NOTIFY_ON=failure
# ntfy.sh örneği: https://ntfy.sh/benim-gizli-konum
NTFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
